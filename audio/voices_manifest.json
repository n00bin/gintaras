"puck_cv10": {
"cv10:10": "Tomai, ar tau patinka Vilnius?",
"cv10:12": "O ką veiki rytoj?",
"cv10:14": "Puiku! Mano mama gyvena Kaune.",
"cv10:3": "Sveikas, Tomai! Kaip sekasi?",
"cv10:5": "Gerai, bet šiandien esu labai pavargęs."
},
"puck_cv13": {
"cv13:0": "Labas! Kur važiuosi atostogų?",
"cv13:10": "O ką veiksi rytoj?",
"cv13:12": "Gerai. Iki!",
"cv13:2": "Puiku! Su kuo?",
"cv13:4": "Kiek laiko būsi ten?",
"cv13:6": "Ar važiuosi traukiniu?",
"cv13:8": "Ar galiu važiuoti kartu?",
"cv13:9o0-0": "Sutarta!",
"cv13:9o1-0": "Gerai, pagalvok."
},
"puck_cv15": {
"cv15:0": "Aš manau, kad Kaunas gražesnis už Vilnių.",
"cv15:11": "Buvo labai malonu.",
"cv15:2o0-0": "Kodėl tu taip manai?",
"cv15:2o1-0": "Ačiū, Tomai!",
"cv15:3": "Gerai, gerai. O kas geriau, kava ar arbata?",
"cv15:7": "O ką veiksi rytoj?"
},
"puck_cv18": {
"cv18:15": "Ar tu girdi?",
"cv18:9": "Labas, Tomai!"
},
"puck_cv2": {
"cv2:0": "Labas! Aš esu Jonas.",
"cv2:10": "Taip, mano darbas įdomus! O kuo tu dirbi?",
"cv2:11o0-0": "Puiku! Ką tu studijuoji?",
"cv2:11o1-0": "Patogu! Ar tau patinka?",
"cv2:12": "Tu labai gerai kalbi lietuviškai!",
"cv2:14": "Sėkmės! Iki!",
"cv2:2": "Malonu. Iš kur tu esi?",
"cv2:4": "Aš esu iš Kauno. Kur tu gyveni?",
"cv2:6": "Aš irgi gyvenu Vilniuje, senamiestyje.",
"cv2:8": "Aš esu mokytojas."
},
"puck_cv21": {
"cv21:0": "Labas! Ar tu dabar dirbi?",
"cv21:10": "Katedra.",
"cv21:13": "Labas! Tu vėluoji!",
"cv21:15": "Jau dvylika trisdešimt!",
"cv21:17": "Gerai! Einame į muziejų?",
"cv21:2": "Ar tu rytoj dirbi?",
"cv21:4": "O šiandien?",
"cv21:6": "Gerai! Tai kada?",
"cv21:7o0-0": "Šeštadienis? Puiku!",
"cv21:7o1-0": "Sekmadienis? Puiku!",
"cv21:8": "Kada? Dvyliktą?"
},
"puck_cv25": {
"cv25:0": "Pažiūrėk, čia mano šeima.",
"cv25:10o0-0": "Koks jis?",
"cv25:10o1-0": "Kokia ji?",
"cv25:10o2-0": "Gerai.",
"cv25:11": "Ar turi vaikų?",
"cv25:12o0-0": "Puiku!",
"cv25:12o1-0": "Puiku! Dukra!",
"cv25:12o2-0": "Nieko tokio!",
"cv25:13": "O čia mano mama ir tėtis.",
"cv25:15": "Ačiū! Dar kavos?",
"cv25:2": "Tai mano brolis, Mantas.",
"cv25:4": "Jis labai linksmas ir protingas. Ir aukštas!",
"cv25:6": "Tai mano sesuo.",
"cv25:8": "Gintarė. Ji gyvena Kaune.",
"cv25:9": "O tu? Ar turi brolių ar seserų?"
},
"puck_cv28": {
"cv28:0": "Labas! Ar gali man padėti šeštadienį?",
"cv28:11": "Labai ačiū, Tomai!",
"cv28:1o0-0": "Ačiū! Aš keliuosi.",
"cv28:1o1-0": "O sekmadienį?",
"cv28:1o1-2": "Puiku! Tada sekmadienį.",
"cv28:2": "Ar moki vairuoti? Aš turiu mašiną, bet esu pavargęs.",
"cv28:3o0-0": "Puiku! Ačiū!",
"cv28:3o1-0": "Nieko tokio. Aš moku.",
"cv28:4": "Padėk man, prašau!",
"cv28:7": "Ačiū! Ar nori valgyti?",
"cv28:8o0-0": "Aš irgi!",
"cv28:8o1-0": "Suprantu! Aš irgi.",
"cv28:9": "Ačiū už viską! Ar tau reikia pinigų?"
},
"puck_cv29": {
"cv29:0": "Labas! Šiandien einame prie ežero?",
"cv29:10": "Puiku! Antrą valandą prie stoties.",
"cv29:2": "Lyja tik ryte. Po pietų bus saulė!",
"cv29:4": "Nieko tokio! Arbatos ar kavos?",
"cv29:5o0-0": "Gerai!",
"cv29:5o1-0": "Pyrago? Gerai, gerai!",
"cv29:6": "Bet vanduo šaltas...",
"cv29:8": "Puiku! Mano sesuo irgi nori. Gerai?"
},
"puck_cv3": {
"cv3:19": "Arbatpinigiai?",
"cv3:4": "O aš norėčiau kavos su pienu."
},
"puck_me2": {
"me2:cv10:10~n": "Ar tau patinka Vilnius?",
"me2:cv10:3~n": "Sveikas! Kaip sekasi?",
"me2:cv10:3~nf": "Sveika! Kaip sekasi?",
"me2:cv15:2o1-0~n": "Ačiū!",
"me2:cv18:9~n": "Labas!",
"me2:cv28:11~n": "Labai ačiū!"
},
"pulcherrima_cv31": {
"cv31:1": "Jūra? Toli. Važiuokite autobusu.",
"cv31:11": "Bet jūsų lagaminas didelis. Gal taksi?",
"cv31:12o0-0": "Gerai, tada autobusu! Sėkmės!",
"cv31:12o1-0": "Taksi ten, prie stoties.",
"cv31:3": "Dvidešimt minučių.",
"cv31:5": "Ten, tiesiai, paskui dešinėn. Jūs turistas?",
"cv31:7": "Sveiki atvykę! Ar jau matėte jūrą?",
"cv31:9": "O! Jūra, miškas..."
},
"pulcherrima_cv35": {
"cv35:0": "Labas vakaras!",
"cv35:10": "Labanakt!",
"cv35:2": "Kaip sekasi?",
"cv35:5": "Atsiprašau!",
"cv35:8": "Ačiū!"
},
"sadachbia_cv33": {
"cv33:0": "Laba diena. Kas atsitiko?",
"cv33:10": "Štai adresas.",
"cv33:12": "Sėkmės!",
"cv33:2": "Kur? Kada?",
"cv33:4": "Ką paėmė?",
"cv33:6": "Ar jums viskas gerai? Ar reikia gydytojo?",
"cv33:8": "Gerai. Dėl paso – į ambasadą."
},
"schedar_cv19": {
"cv19:11": "Senamiestis... štai! Ar kalbate angliškai?",
"cv19:12o0-0": "Puiku! Tada kalbame lietuviškai.",
"cv19:12o1-0": "Ne, tik lietuviškai!",
"cv19:13": "Gerai. Kur?",
"cv19:15": "Restoranas? Tiesiai, tiesiai, paskui dešinėn, ir...",
"cv19:17": "Tiesiai. Paskui dešinėn.",
"cv19:19": "Nieko! O kodėl jūs čia, Vilniuje?",
"cv19:2": "Taip? Kas yra?",
"cv19:21": "Puiku! Sėkmės!",
"cv19:4": "Taip, taip!",
"cv19:7": "Tai Reksas!",
"cv19:9": "Jūs esate čia: senamiestis."
},
"sulafat_cv9": {
"cv9:0": "Laba diena. Kuo galiu padėti?",
"cv9:10": "Aštuoni eurai.",
"cv9:12": "Taip, prašau!",
"cv9:2": "Kas jums skauda?",
"cv9:4": "Ar turite temperatūros?",
"cv9:5o0-0": "Nieko tokio.",
"cv9:5o1-0": "Tada daug vandens!",
"cv9:6": "Štai vaistai. Viena tabletė, tris kartus per dieną.",
"cv9:8": "Viena tabletė. Tris kartus per dieną."
},
"vindemiatrix_cv20": {
"cv20:0": "Laba diena! Prašau?",
"cv20:10": "Ačiū. Štai penki eurai.",
"cv20:12": "Čia mano anūkas, Lukas.",
"cv20:14": "Penkeri!",
"cv20:15": "O tau? Kiek tau metų?",
"cv20:16o0-0": "Dvidešimt! Daug!",
"cv20:16o1-0": "Trisdešimt! Labai daug!",
"cv20:17": "Labai ačiū! Iki pasimatymo!",
"cv20:2": "Kava? Du eurai.",
"cv20:4": "Pyragas – vienas euras. Kiek?",
"cv20:6": "Trys pyragai ir kava. Penki eurai.",
"cv20:8": "Penki. Penki eurai."
},
"zephyr_cv32": {
"cv32:0": "Laba diena. Kas yra?",
"cv32:10": "Ne! Lova ir arbata.",
"cv32:13": "Kaip jūs?",
"cv32:2": "Ar kosėjate?",
"cv32:4": "Ar skauda galvą?",
"cv32:5o0-0": "Gerai.",
"cv32:5o1-0": "Gerai.",
"cv32:6": "Temperatūra trisdešimt aštuoni.",
"cv32:8": "Taip. Štai receptas."
}
}