"erinome_cv23": {
"cv23:0": "Laba diena! Kur važiuojate?",
"cv23:10": "Po pusantros valandos.",
"cv23:2": "Prašau. Septyni eurai.",
"cv23:4": "Žinoma.",
"cv23:6": "Po dešimt minučių. Iš ketvirtos platformos.",
"cv23:8": "Ten, kairėn."
},
"fenrir_cv23": {
"cv23:13": "Laba diena! Taksi?",
"cv23:15": "Gerai. Kuris viešbutis?",
"cv23:17": "A, žinau. Netoli.",
"cv23:19": "Apie dešimt eurų.",
"cv23:22": "Pirmą kartą Kaune?",
"cv23:23o0-0": "Sveiki atvykę į Kauną!",
"cv23:23o1-0": "O, Vilnius! Gražus miestas.",
"cv23:24": "Viešbutis ten, už kampo.",
"cv23:26": "Gerai. Dešimt eurų.",
"cv23:28": "Ačiū! Geros dienos Kaune!"
},
"gacrux_cv5": {
"cv5:0": "Laba diena! Ko norėtumėte?",
"cv5:11": "Ne, tik grynaisiais.",
"cv5:13": "Ačiū! Štai jūsų grąža.",
"cv5:2": "Taip, žinoma! Raudoni ar žali?",
"cv5:4": "Gerai. Kiek kilogramų?",
"cv5:6": "Prašau. Dar ko nors?",
"cv5:8": "Sūris? Penki eurai.",
"cv5:9o0-0": "Gerai, gerai. Keturi eurai.",
"cv5:9o0-2": "Iš viso šeši eurai.",
"cv5:9o1-0": "Iš viso septyni eurai."
},
"kore_cv1": {
"cv1:0": "Labas rytas!",
"cv1:10": "Iš kur tu esi?",
"cv1:18": "Atsiprašau! Mano telefonas...",
"cv1:2": "Prašau, sėskitės.",
"cv1:20": "Oi, man reikia eiti. Aš einu į muziejų.",
"cv1:22": "Ačiū! Viso gero, Tomai!",
"cv1:4": "Aš esu Rūta. Koks tavo vardas?",
"cv1:6": "Malonu susipažinti, Tomai!",
"cv1:8": "Kaip sekasi?",
"cv1:9o0-0": "Puiku!",
"cv1:9o1-0": "Gerai, gerai!"
},
"kore_cv10": {
"cv10:0": "Labas vakaras! Užeik!",
"cv10:15": "Į sveikatą!",
"cv10:19": "Ačiū, kad atėjai! Labanakt!",
"cv10:2": "Ačiū! Labai gražu!",
"cv10:7": "Ar esi alkanas? Turiu cepelinų!",
"cv10:8o0-0": "Skanaus!",
"cv10:8o1-0": "Nieko tokio! Turiu ir sriubos. Skanaus!"
},
"kore_cv11": {
"cv11:0": "Labas! Kada tu keliesi?",
"cv11:10": "Aš kasdien! O kiek tu miegi?",
"cv11:12": "Aštuonias! O aš tik šešias. Ar tu kartais vėluoji?",
"cv11:14": "Šaunu! O aš dažnai vėluoju... Na, iki rytojaus!",
"cv11:2": "Anksti! O ką darai ryte?",
"cv11:4": "Aš irgi! Ar tu dirbi iš namų?",
"cv11:5o0-0": "Kaip tu važiuoji?",
"cv11:5o0-2": "O kada tu grįžti?",
"cv11:5o1-0": "Smagu! Ar visada?",
"cv11:6": "O vakare?",
"cv11:8": "Puiku. Ar dažnai žiūri filmus?"
},
"kore_cv14": {
"cv14:0": "Labas! Kaip praėjo savaitgalis?",
"cv14:10": "O sekmadienį?",
"cv14:12": "Ką veikei namie?",
"cv14:14": "Smagu! Kitą savaitgalį einame kartu?",
"cv14:2": "Ką veikei?",
"cv14:4": "O ką ten veikei?",
"cv14:6": "Ar valgėte kur nors?",
"cv14:8": "Ar tau patiko?",
"cv14:9o1-0": "Kodėl?"
},
"kore_cv15": {
"cv15:1": "Tikrai? Kaip tu manai, Tomai?",
"cv15:2o0-2": "Aš sutinku su Tomu!",
"cv15:2o1-1": "O aš nesutinku! Vilnius gražesnis.",
"cv15:5": "Aš manau, kad arbata geresnė už kavą.",
"cv15:9": "Tai ateik pas mus vakarienės!"
},
"kore_cv16": {
"cv16:0": "Labas, Tomai! Kaip sekasi?",
"cv16:10": "Einame pasivaikščioti?",
"cv16:12": "Pasivaikščioti... štai taip!",
"cv16:16": "Upė.",
"cv16:18": "U-pė. Upė.",
"cv16:1o0-0": "Man irgi gerai!",
"cv16:1o1-0": "Man irgi neblogai.",
"cv16:1o2-0": "Man gerai. Rytoj bus geriau!",
"cv16:2": "Ką veiki?",
"cv16:20": "Teisingai! Tu greitai mokaisi.",
"cv16:22": "Aš labai mėgstu čia vaikščioti.",
"cv16:24": "Na, man jau laikas. Geros dienos!",
"cv16:4": "Puiku! Tu kalbi lietuviškai?",
"cv16:6": "Šiandien toks gražus oras! Gal einame pasivaikščioti prie upės, o paskui išgersime kavos?",
"cv16:8": "Nieko tokio!"
},
"kore_cv18": {
"cv18:0": "Labas! Ką tu darai?",
"cv18:13": "Ne, ne! Šiandien aš moku.",
"cv18:17": "Greičiau! Einame!",
"cv18:2": "Mes laukiame stotyje. Ar tu ateini?",
"cv18:4": "Kur tu dabar?",
"cv18:6": "Ar tu matai bažnyčią? Stotis yra prie bažnyčios.",
"cv18:7o0-0": "Puiku! Mes stovime prie durų.",
"cv18:7o1-0": "Eik tiesiai, paskui kairėn."
},
"kore_cv22": {
"cv22:0": "Laba diena, Tomai! Užeik, prašau.",
"cv22:11": "Štai sriuba, duona ir sūris. Skanaus!",
"cv22:15": "Ar viskas gerai?",
"cv22:17": "Prašau, štai druska.",
"cv22:2": "Čia mano tėtis, Vytautas.",
"cv22:24": "Jau vėlu! Ačiū, kad atvažiavai.",
"cv22:6": "Puiku! Sėskis. Ar nori kavos?",
"cv22:7o0-0": "Gerai, štai arbata.",
"cv22:7o1-0": "Prašau, štai kava."
},
"kore_cv6": {
"cv6:0": "Labas! Ką veiki savaitgalį?",
"cv6:10": "Aš jau čia. Kur tu?",
"cv6:12": "Nieko tokio! Laukiu.",
"cv6:2": "Šeštadienį einu į kiną. Ar nori eiti kartu?",
"cv6:4": "Puiku! Kelintą valandą?",
"cv6:5o0-0": "Septintą tinka! Kur susitiksime?",
"cv6:5o1-0": "Aštuntą per vėlu. Gal septintą?",
"cv6:5o1-2": "Puiku! Kur susitiksime?",
"cv6:7": "Puiki idėja! Iki šeštadienio!"
},
"kore_cv7": {
"cv7:0": "Žiūrėk, čia mano šeima.",
"cv7:10o0-0": "Aš irgi! Gal savaitgalį einame į muziejų?",
"cv7:10o1-0": "Šaunu! Gal savaitgalį gaminame kartu?",
"cv7:12": "Sutarta!",
"cv7:2": "Taip, aš turiu brolį. Čia jis.",
"cv7:4": "Jo vardas Mantas. O tu? Ar turi brolių ar seserų?",
"cv7:5o0-0": "Smagu! Ar tau patinka Lietuva?",
"cv7:5o1-0": "Kaip aš! Ar tau patinka Lietuva?",
"cv7:5o2-0": "Gaila! Ar tau patinka Lietuva?",
"cv7:7": "Bet šiandien šalta, ar ne?",
"cv7:9": "Ką tu mėgsti veikti?"
},
"kore_me2": {
"me2:cv10:7~f": "Ar esi alkana? Turiu cepelinų!",
"me2:cv15:1~n": "Tikrai? Kaip tu manai?",
