"laomedeia_cv17": {
"cv17:0": "Labas! Aš esu Laura. Tu esi Tomas?",
"cv17:10": "O ką tu darai? Tu dirbi?",
"cv17:11o0-0": "Aš irgi dirbu. Ir daug miegu!",
"cv17:11o1-0": "Puiku! Mokytis yra gerai.",
"cv17:12": "Ar nori arbatos ar kavos? Čia labai skani kava, bet arbata irgi gera...",
"cv17:14": "Ar nori gerti? Kava, arbata?",
"cv17:17": "Prašau. O ką tu skaitai?",
"cv17:19": "Šaunu! Ar tu žinai, kiek valandų?",
"cv17:2": "Malonu! Ar tu kalbi lietuviškai?",
"cv17:21": "Oi, jau vėlu! Mes su Rūta einame namo.",
"cv17:23": "Iki! Tu gerai kalbi lietuviškai!",
"cv17:4": "Labai gerai! O aš mokausi anglų kalbos.",
"cv17:6": "Truputį. Bet šiandien kalbame lietuviškai!",
"cv17:8": "Ar tu gyveni Lietuvoje?"
},
"laomedeia_cv27": {
"cv27:0": "Labas! Užeik, užeik! Koks šiandien oras?",
"cv27:11": "O, atsiprašau! Ir tamsu.",
"cv27:13": "Gerai. Kaip tu jautiesi? Tu atrodai pavargęs.",
"cv27:14o0-0": "Tada arbata padės!",
"cv27:14o1-0": "Puiku! Aš irgi.",
"cv27:17": "Nėra už ką! Ateik dar!",
"cv27:2": "Jauskis kaip namie. Sėskis!",
"cv27:4": "Ačiū! Bet jis mažas. Čia svetainė, ten virtuvė, o ten miegamasis.",
"cv27:6": "Ten, prie durų.",
"cv27:7": "Ar nori arbatos?",
"cv27:8o0-0": "Štai arbata. Karšta!",
"cv27:8o1-0": "Gerai, štai kava.",
"cv27:9": "Kambaryje šalta, ar ne?"
},
"laomedeia_me2": {
"me2:cv17:0~n": "Labas! Aš esu Laura. Tu esi?",
"me2:cv27:13~f": "Gerai. Kaip tu jautiesi? Tu atrodai pavargusi."
},
"leda_cv12": {
"cv12:0": "Laba diena! Ar galiu padėti?",
"cv12:11": "Taip, štai.",
"cv12:13": "Šešiasdešimt eurų.",
"cv12:15": "Šiandien yra dešimt procentų nuolaida.",
"cv12:16o1-0": "Gerai. Bet nuolaida tik šiandien!",
"cv12:17": "Puiku! Kortele ar grynaisiais?",
"cv12:19": "Ačiū! Gražios dienos!",
"cv12:3": "Šios striukės labai populiarios.",
"cv12:5": "Kokio dydžio?",
"cv12:7": "Prašau. Matavimosi kabina ten.",
"cv12:9": "Na, kaip?"
},
"orus_cv1": {
"cv1:1": "Labas rytas!",
"cv1:11": "Aš esu iš Amerikos.",
"cv1:14": "Laba diena! Ne, ačiū.",
"cv1:16": "Taip, prašau.",
"cv1:19": "Nieko tokio!",
"cv1:21": "Sėkmės! Iki pasimatymo!",
"cv1:23": "Viso gero!",
"cv1:3": "Ačiū!",
"cv1:5": "Mano vardas Tomas.",
"cv1:7": "Malonu susipažinti!",
"cv1:9o0": "Puikiai!",
"cv1:9o1": "Gerai, ačiū."
},
"orus_cv10": {
"cv10:1": "Labas vakaras! Čia tau dovana.",
"cv10:11": "Taip, labai! Vilnius labai gražus.",
"cv10:13": "Rytoj aš važiuoju į Kauną.",
"cv10:16": "Į sveikatą!",
"cv10:18": "Labai ačiū! Iki pasimatymo!",
"cv10:4": "Puikiai, ačiū. O tau?",
"cv10:6": "Aš irgi!",
"cv10:8o0": "Taip, aš esu alkanas!",
"cv10:8o1": "Atsiprašau, aš nevalgau mėsos.",
"cv10:9": "Ačiū! Labai skanu!"
},
"orus_cv11": {
"cv11:1": "Aš keliuosi septintą valandą.",
"cv11:11": "Aš miegu aštuonias valandas.",
"cv11:13": "Ne, aš niekada nevėluoju!",
"cv11:15": "Iki!",
"cv11:3": "Aš prausiuosi ir geriu kavą.",
"cv11:5o0": "Ne, aš einu į darbą.",
"cv11:5o0-1": "Aš važiuoju autobusu.",
"cv11:5o0-3": "Aš dirbu iki penkių.",
"cv11:5o1": "Taip, aš dirbu iš namų.",
"cv11:5o1-1": "Ne. Kartais aš dirbu iš namų.",
"cv11:7": "Aš grįžtu namo ir gaminu vakarienę.",
"cv11:9": "Kartais."
},
"orus_cv12": {
"cv12:1": "Tik žiūriu, ačiū.",
"cv12:10": "Netinka. Ar yra didesnis?",
"cv12:12": "Tinka! Kiek kainuoja?",
"cv12:14": "Brangu! Ar yra nuolaida?",
"cv12:16o0": "Gerai, aš imu.",
"cv12:16o1": "Aš pagalvosiu.",
"cv12:16o1-1": "Gerai, gerai. Aš imu.",
"cv12:18": "Kortele, prašau.",
"cv12:20": "Ačiū! Viso gero!",
"cv12:4": "Man patinka ši striukė.",
"cv12:6": "Mano dydis vidutinis."
},
"orus_cv13": {
"cv13:1": "Vasarą aš važiuosiu prie jūros.",
"cv13:11": "Rytoj aš dirbsiu.",
"cv13:13": "Sėkmės! Iki!",
"cv13:3": "Aš aplankysiu draugus.",
"cv13:5": "Aš būsiu ten savaitę.",
"cv13:7": "Ne, aš važiuosiu autobusu.",
"cv13:9o0": "Taip, bus smagu!",
"cv13:9o1": "Aš pagalvosiu."
},
"orus_cv14": {
"cv14:1": "Labai gerai! Buvo smagu.",
"cv14:11": "Aš buvau namie, nes buvo šalta.",
"cv14:13": "Aš žiūrėjau filmą.",
"cv14:15": "Taip, bus smagu!",
"cv14:3": "Aš buvau mieste.",
"cv14:5": "Aš susitikau su draugu.",
"cv14:7": "Taip, mes valgėme restorane.",
"cv14:9o0": "Labai patiko, bet buvo brangu.",
"cv14:9o1": "Man nepatiko.",
"cv14:9o1-1": "Nes buvo brangu."
},
"orus_cv15": {
"cv15:10": "Kaip smagu! Ačiū!",
"cv15:12": "Man irgi. Iki kito karto!",
"cv15:2o0": "Aš nesutinku. Vilnius labai gražus.",
"cv15:2o0-1": "Nes man patinka senas miestas.",
"cv15:2o1": "Aš sutinku su tavimi.",
"cv15:4": "Man labiau patinka kava.",
"cv15:6": "Man tas pats.",
"cv15:8": "Rytoj aš dirbsiu, bet vakare aš būsiu namie."
},
"orus_cv16": {
"cv16:11": "Ką reiškia šis žodis?",
"cv16:13": "Supratau! Taip, gerai.",
"cv16:15": "Kaip tai pasakyti lietuviškai?",
"cv16:17": "Dar kartą, prašau.",
"cv16:19": "Ačiū! Supratau.",
"cv16:1o0": "Gerai, ačiū. O tau?",
"cv16:1o1": "Neblogai. O tau?",
"cv16:1o2": "Taip sau. O tau?",
"cv16:21": "Ačiū! Labai malonu.",
"cv16:23": "Aš irgi!",
"cv16:25": "Ir tau! Iki!",
"cv16:3": "Nieko ypatingo. Aš mokausi.",
"cv16:5": "Aš truputį kalbu lietuviškai.",
"cv16:7": "Palauk! Aš nelabai suprantu.",
"cv16:9": "Ar gali pakartoti?"
},
"orus_cv17": {
"cv17:1": "Taip, aš esu Tomas.",
"cv17:11o0": "Taip, aš dirbu.",
"cv17:11o1": "Ne, aš mokausi.",
"cv17:13": "Atsiprašau, aš nesuprantu.",
"cv17:15": "Taip, aš noriu. Ačiū!",
"cv17:18": "Aš skaitau lietuviškai!",
"cv17:20": "Ne, aš nežinau.",
"cv17:22": "Gerai. Iki pasimatymo!",
"cv17:24": "Ačiū! Labanakt!",
"cv17:3": "Aš kalbu truputį lietuviškai.",
"cv17:5": "Ar tu kalbi angliškai?",
"cv17:7": "Gerai! Aš mokausi lietuvių kalbos.",
"cv17:9": "Taip, aš gyvenu Lietuvoje."
},
"orus_cv18": {
"cv18:1": "Labas! Aš perku duoną.",
"cv18:10": "Labas! Ką jūs darote?",
"cv18:12": "Ačiū! Aš moku.",
"cv18:14": "Ačiū, Rūta!",
"cv18:16": "Taip, aš girdžiu! Palauk manęs!",
"cv18:18": "Taip, einame!",
"cv18:3": "Taip, aš ateinu! Aš skubu.",
"cv18:5": "Aš ieškau stoties.",
"cv18:7o0": "Taip, aš matau!",
"cv18:7o1": "Palauk, aš galvoju..."
},
"orus_cv19": {
"cv19:1": "Atsiprašau!",
"cv19:10": "Atsiprašau, ką tai reiškia?",
"cv19:12o0": "Taip. Aš mokausi lietuvių kalbos.",
"cv19:12o1": "Truputį. Ar jūs kalbate angliškai?",
"cv19:14": "Kur yra kavinė?",
"cv19:16": "Palauk! Dar kartą, prašau.",
"cv19:18": "Supratau! Labai ačiū!",
"cv19:20": "Aš gyvenu Lietuvoje ir mokausi.",
"cv19:22": "Ačiū! Viso gero!",
"cv19:3": "Ar galite man padėti?",
"cv19:6": "Kas tai?",
"cv19:8": "Kur aš esu?"
},
"orus_cv2": {
"cv2:1": "Labas! Mano vardas Tomas.",
"cv2:11o0": "Aš esu studentas.",
"cv2:11o0-1": "Aš mokausi lietuvių kalbos.",
"cv2:11o1": "Aš dirbu iš namų.",
"cv2:11o1-1": "Taip, mano darbas įdomus.",
